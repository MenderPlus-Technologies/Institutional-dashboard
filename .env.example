# Copy to .env.local for local development, and add the same values in
# Netlify → Site configuration → Environment variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended: lets the portal email team invitations.
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

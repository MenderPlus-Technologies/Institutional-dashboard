# Public base URL of the Indura API. No trailing slash.
# Do not put secrets, API keys, or tokens in NEXT_PUBLIC_* variables.
# Example: https://api.indurahealth.com/api
NEXT_PUBLIC_API_URL=https://api.indurahealth.com/api

# Public portal origin. Checkout returns to {origin}/funding/return.
# Must be an https://*.indurahealth.com host. Localhost is rejected by the API.
# Example: https://www.indurahealth.com
NEXT_PUBLIC_PORTAL_URL=https://www.indurahealth.com
